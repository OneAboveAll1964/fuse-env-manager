{
  "name": "fuse-env-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently --names \"vite,electron\" --prefix-colors \"blue,magenta\" --kill-others \"yarn dev:vite\" \"yarn dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "node scripts/build-electron.mjs --watch & node scripts/launch-electron.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "build": "tsc -b && vite build && yarn build:electron && yarn build:cli && electron-builder",
    "build:unpacked": "tsc -b && vite build && yarn build:electron && yarn build:cli && electron-builder --dir",
    "build:mac": "tsc -b && vite build && yarn build:electron && yarn build:cli && electron-builder --mac",
    "build:win": "tsc -b && vite build && yarn build:electron && yarn build:cli && electron-builder --win",
    "build:linux": "tsc -b && vite build && yarn build:electron && yarn build:cli && electron-builder --linux",
    "build:all": "tsc -b && vite build && yarn build:electron && yarn build:cli && electron-builder --win --mac",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/make-icons.mjs",
    "sync:cli": "node scripts/sync-cli.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "png2icons": "^2.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "tailwindcss-rtl": "^0.9.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
